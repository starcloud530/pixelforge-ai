{
  "name": "@pixelforge/web",
  "private": true,
  "version": "0.1.0",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm --dir ../.. run build:wasm",
    "dev": "vite",
    "prebuild": "pnpm --dir ../.. run build:wasm",
    "build": "tsc --noEmit && vite build",
    "pretypecheck": "pnpm --dir ../.. run build:wasm",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json --noEmit && node --import tsx --test src/ai/turn.test.ts src/ai/proxy.test.ts",
    "preview": "vite preview --host 0.0.0.0 --port 4173"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
