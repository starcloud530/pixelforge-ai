# Copy to apps/web/.env.local and fill in a key. Never commit the copy.
# pnpm dev and pnpm preview read this file on the server. The page does not receive the key.

# PIXELFORGE_AI_* wins when both are set.
PIXELFORGE_AI_API_KEY=
# OPENAI_API_KEY=

# API root only. The driver appends /chat/completions.
# Swap this for any OpenAI-compatible GPT-class or Astra-class host.
PIXELFORGE_AI_BASE_URL=https://api.openai.com/v1
# OPENAI_BASE_URL=

# Model id sent as JSON "model". The default name is a label, not a separate SDK.
PIXELFORGE_AI_MODEL=gpt-6-astra
# OPENAI_MODEL=
